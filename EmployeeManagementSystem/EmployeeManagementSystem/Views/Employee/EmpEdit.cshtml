@model EmployeeManagementSystem.Models.EmployeeModel

@{
    ViewBag.Title = "EmpEdit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="font-weight:700;text-align:center;margin-top:50px;font-family:Bahnschrift">Edit Employee</h2>



@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-center" >
    <div class="form-horizontal p-3 mx-5 bg-dark" style="border:solid 3px;border-radius:10px;width:500px">
        <h4 class="text-center text-white" style="font-family: Bahnschrift">Employee Form</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.id)

        <div class="form-group">
            <label id="empname" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Employee Name</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.empname, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.empname, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label id="empid" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Employee ID</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.empid, new { htmlAttributes = new { @class = "form-control", type = "text" } })
                @Html.ValidationMessageFor(model => model.empid, "", new { @class = "text-danger" })
            </div>
        </div>

        @*<div class="form-group">
                @Html.LabelFor(model => model.depid, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.depid, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.depid, "", new { @class = "text-danger" })
                </div>
            </div>*@

        <div class="form-group">
            <label id="depid" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Department</label>
            <div>
                @Html.DropDownListFor(
                    model => model.depid,
                    new SelectList(ViewBag.dept, "depid", "deptname"),
                    new { @class = "form-control" }
                )
                @Html.ValidationMessageFor(model => model.depid, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label id="dob" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Date of Birth</label>
            <div class="col-md-10">
            @Html.TextBoxFor(model => model.dob, new { htmlAttributes = new { @class = "form-control", @Value=Model.dob.ToString("dd-MM-yyyy")} })
            @Html.ValidationMessageFor(model => model.dob, "", new { @class = "text-danger" })
        </div>
            @*<div class="col-md-10">
                @Html.TextBoxFor(model => model.dob, new { @class = "form-control", type = "date", @Value = Model.dob.ToString("dd-MM-yyyy") })
                @Html.ValidationMessageFor(model => model.dob, "", new { @class = "text-danger" })
            </div>*@
        </div>

        <div class="form-group">
            <label id="gender" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Gender</label>
            <div class="col-md-10">
                

                <div class="d-flex gap-3">
                    <div class="form-check">
                        @Html.RadioButtonFor(model => model.gender,"Male", new { @class = "form-check-input", id = "genderMale" })
                        <label for="genderMale" class="form-check-label text-white" style="font-family: Bahnschrift">Male</label>
                    </div>
                    <div class="form-check">
                        @Html.RadioButtonFor(model => model.gender,"Female", new { @class = "form-check-input", id = "genderFemale" })
                        <label for="genderFemale" class="form-check-label text-white" style="font-family: Bahnschrift">Female</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label id="address" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Address</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.address, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.address, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label id="phone" style="font-weight: 700; color: whitesmoke; font-family: Bahnschrift">Phone number</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.phone, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.phone, "", new { @class = "text-danger" })
            </div>
        </div>

        <div id="updateStatus"></div>

        <div class="form-group  mt-3 text-center d-flex justify-content-center">        
                <button type="button" id="updateBtn" class="btn btn-primary px-5">Save</button>
                <div>
                    @Html.ActionLink("Back to List", "EmpShow", null, new { @class = "btn btn-secondary  ms-5 ", style = "color:white;" })
                </div>
        </div>
    </div>
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
    $(document).ready(function () {
        $('#updateBtn').click(function () {
            var empData = {
                id: $('#id').val(),
                empname: $('#empname').val(),
                empid: $('#empid').val(),
                depid: $('#depid').val(),
                dob: $('#dob').val(),
                gender: $('#gender').val(),
                address: $('#address').val(),
                phone: $('#phone').val()
            };

            $.ajax({
                url: '@Url.Action("EmpEdit", "Employee")',
                type: 'POST',
                data: JSON.stringify(empData),
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response.success) {
                        $('#updateStatus').html('<div class="alert alert-success">' + response.message + '</div>');
                    } else {
                        $('#updateStatus').html('<div class="alert alert-danger">' + response.message + '</div>');
                    }
                },
                error: function (xhr) {
                    $('#updateStatus').html('<div class="alert alert-danger">Error: ' + xhr.responseText + '</div>');
                }
            });
        });
    });
    </script>
}
