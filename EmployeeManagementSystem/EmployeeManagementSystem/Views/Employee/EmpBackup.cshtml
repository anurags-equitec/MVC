@model IEnumerable<EmployeeManagementSystem.Models.BackupModel>

@{
    ViewBag.Title = "EmpBackup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="font-weight:700;text-align:center;margin-top:50px;font-family:Bahnschrift">Deleted Employee List</h2>

<p>
    @Html.ActionLink("Back to List", "EmpShow", null, new { @class = "btn btn-secondary", style = "color:white;" })
    @Html.ActionLink("Print", "", null, new { @class = "btn btn-danger ",id= "printButton", style = "color:white;margin-left:70%" })
    @Html.ActionLink("Download", "", null, new { @class = "btn btn-success",id= "exportButton", style = "color:white;" })
</p>
<div class="main mt-4" style="border:solid 5px;border-radius:10px;">
    <table class="table table-dark table-hover" id="emptable">
        <tr>
            <th>
                Sr No
            </th>
            <th>
                @Html.DisplayNameFor(model => model.empname)
            </th>
            @*<th>
                    @Html.DisplayNameFor(model => model.empid)
                </th>*@
            @*<th>
                    @Html.DisplayNameFor(model => model.depid)
                </th>*@
            @*<th>
                    @Html.DisplayNameFor(model => model.deptname)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.dob)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.gender)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.address)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.phone)
                </th>*@
            <th>Actions</th>
        </tr>

        @{int i = 1; }
        @foreach (var item in Model)
        {

            <tr>
                <td>
                    @i
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.empname)
                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.empid)
                    </td>*@
                @*<td>
                        @Html.DisplayFor(modelItem => item.depid)
                    </td>*@
                @*<td>
                        @Html.DisplayFor(modelItem => item.deptname)
                    </td>
                    <td>
                        @(DateTime.Now.Subtract(item.dob).Days/365)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.gender)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.address)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.phone)
                    </td>*@
                <td>
                    @Html.ActionLink("Restore", "EmpRestore", new { id = item.id }, new { @class = "btn btn-warning mx-3", style = "color:white" })
                    @Html.ActionLink("View", "EmpDelDetail", new { id = item.id }, new { @class = "btn btn-primary mx-3", style = "color:white" })

                </td>
            </tr>
            i = i + 1;
        }

    </table>
    <div class="pagemp mx-5">
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            @Html.ActionLink("Previous", "EmpBackup", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = 5 }, new { @class = "page-link" })
                        </li>
                    }

                    @for (int j = 1; j <= ViewBag.TotalPages; j++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            @Html.ActionLink(j.ToString(), "EmpBackup", new { pageNumber = j, pageSize = 5 }, new { @class = "page-link" })
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            @Html.ActionLink("Next", "EmpBackup", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = 5 }, new { @class = "page-link" })
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
    $("#printButton").click(function () {
            var printContents = document.getElementById('emptable').outerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = "<h2>Deleted Employees List</h2>" + printContents;
            window.print();
            document.body.innerHTML = originalContents;
            location.reload();
        });

        $("#exportButton").click(function () {
            var table = document.getElementById('emptable');
            var workbook = XLSX.utils.table_to_book(table, { sheet: "Deleted Employees" });
            XLSX.writeFile(workbook, 'DeletedEmployees.xlsx');
        });</script>
}