@model EmployeeManagementSystem.Models.BackupModel

@{
    ViewBag.Title = "EmpDelDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="font-weight:700;text-align:center;margin-top:50px;font-family:Bahnschrift">Deleted Employee Detail</h2>

<div class="detail px-5 bg-dark" style="border:solid 2px; border-radius:10px;">
    <div>
        <h4 style="font-weight: 700; text-align: center; margin-top: 50px; font-family: Bahnschrift; color: whitesmoke">Employee</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt style="font-family: Bahnschrift;color:whitesmoke">
                @*@Html.DisplayNameFor(model => model.empname)*@
                Employee Name
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.empname)
            </dd>

            <dt style="font-family: Bahnschrift; color: whitesmoke " >
                @*@Html.DisplayNameFor(model => model.empid)*@
                Employee Id
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.empid)
            </dd>

            <!--<dt>-->
            @*@Html.DisplayNameFor(model => model.depid)*@
            <!--</dt>

            <dd>-->
            @*@Html.DisplayFor(model => model.depid)*@
            <!--</dd>-->

            <dt style="font-family: Bahnschrift; color: whitesmoke ">
                @*@Html.DisplayNameFor(model => model.deptname)*@
                Department
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.deptname)
            </dd>

            <dt style="font-family: Bahnschrift; color: whitesmoke ">
            @Html.DisplayNameFor(model => model.dob)
            Age
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
            @(DateTime.Now.Subtract(Model.dob).Days/365)
            </dd>

            <dt style="font-family: Bahnschrift; color: whitesmoke ">
                @*@Html.DisplayNameFor(model => model.gender)*@
                Gender
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.gender)
            </dd>

            <dt style="font-family: Bahnschrift; color: whitesmoke "> 
                @*@Html.DisplayNameFor(model => model.address)*@
                Address
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.address)
            </dd>

            <dt style="font-family: Bahnschrift; color: whitesmoke ">
                @*@Html.DisplayNameFor(model => model.phone)*@
                Phone
            </dt>

            <dd style="font-family: Bahnschrift; color: whitesmoke ">
                @Html.DisplayFor(model => model.phone)
            </dd>

        </dl>
    </div>
    <p>
        @*@Html.ActionLink("Edit", "Edit", new { id = Model.id }, new { @class = "btn btn-warning mx-3", style = "color:white" })*@ 
        @Html.ActionLink("Back to List", "EmpBackup", null, new { @class = "btn btn-secondary", style = "color:white;" })
    </p>
</div>